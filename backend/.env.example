# ==============================================================================
# NETRA / TrustID AI - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Metadata
PROJECT_NAME="TRUSTID AI"
PROJECT_DESCRIPTION="AI Powered Fake Identity & Government Document Screening System"
VERSION="1.0.0"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# File Upload Limits (in bytes, default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Tesseract OCR Executable Path (Optional: override if not in system PATH)
# Windows example: "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux/macOS: usually empty or "/usr/bin/tesseract"
TESSERACT_CMD=""
